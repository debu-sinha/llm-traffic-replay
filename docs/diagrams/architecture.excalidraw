      "isDeleted": false,
      "boundElements": null,
      "updated": 1786050000000,
      "link": null,
      "locked": false,
      "text": "4. SEAL EVIDENCE ONLY AFTER DRAIN\ncorrupt/incomplete streams stay failures and leave latency/usage/cost populations -> promote requests.jsonl -> summary + reports\n-> ambiguous retries withhold aggregate cost -> manifest v3 binds SHA-256 + bytes + row count -> completion marker promoted last\nmerge/compare accept only sealed verified evidence; forced coverage/compatibility failures remain explicitly INVALID",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "4. SEAL EVIDENCE ONLY AFTER DRAIN\ncorrupt/incomplete streams stay failures and leave latency/usage/cost populations -> promote requests.jsonl -> summary + reports\n-> ambiguous retries withhold aggregate cost -> manifest v3 binds SHA-256 + bytes + row count -> completion marker promoted last\nmerge/compare accept only sealed verified evidence; forced coverage/compatibility failures remain explicitly INVALID",
      "lineHeight": 1.25
    },
