      "version": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786050000000,
      "link": null,
      "locked": false,
      "text": "3. RECORD BOTH CLOCK FAMILIES AND OUTCOMES\nfinal-attempt clocks begin immediately before conn.request\ninclude upload/network/edge/endpoint/response transit; the network probe is never subtracted\nexact caller clocks begin at the scheduled target and include queue + connect + fallback + refresh + retries",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3. RECORD BOTH CLOCK FAMILIES AND OUTCOMES\nfinal-attempt clocks begin immediately before conn.request\ninclude upload/network/edge/endpoint/response transit; the network probe is never subtracted\nexact caller clocks begin at the scheduled target and include queue + connect + fallback + refresh + retries",
      "lineHeight": 1.25
    },
