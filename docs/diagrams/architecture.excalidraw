    {
      "id": "stage-2-text",
      "type": "text",
      "x": 105,
      "y": 303,
      "width": 1070,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e3a8a",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 101005,
      "versionNonce": 201005,
      "version": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786050000000,
      "link": null,
      "locked": false,
      "text": "2. PREPARE AND DISPATCH A BOUNDED OPEN-LOOP WORKLOAD\nprofile v1/v2 or real prompts + synthetic schedule or shifted trace -> global index and schedule identity -> shard subset\n-> optional unloaded sizing and calibration -> monotonic dispatcher -> max_concurrency workers + max_pending_requests\n-> cancellation shuts active sockets; workers close them; retries/future POSTs blocked; fallback, auth refresh, or transport retry can create another physical POST",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "2. PREPARE AND DISPATCH A BOUNDED OPEN-LOOP WORKLOAD\nprofile v1/v2 or real prompts + synthetic schedule or shifted trace -> global index and schedule identity -> shard subset\n-> optional unloaded sizing and calibration -> monotonic dispatcher -> max_concurrency workers + max_pending_requests\n-> cancellation shuts active sockets; workers close them; retries/future POSTs blocked; fallback, auth refresh, or transport retry can create another physical POST",
      "lineHeight": 1.25
    },
