    {
      "id": "stage-3-text",
      "type": "text",
      "x": 110,
      "y": 500,
      "width": 1060,
      "height": 100,
      "angle": 0,
      "strokeColor": "#7c2d12",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 101007,
      "versionNonce": 201007,
      "version": 1,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786050000000,
      "link": null,
      "locked": false,
      "text": "3. RECORD BOTH CLOCK FAMILIES, IDENTITY, AND ADMISSION OUTCOMES\nfinal-attempt request-path clocks begin immediately before conn.request; fresh-connection setup is never subtracted\nexact caller clocks begin at the scheduled target and include queue + connect + fallback + refresh + retries\nretain response model/fingerprint + served-model-name and terminal guard events; first_content includes reasoning, visible, or refusal onset\nfailed/partial attempts remain in reliability and occupancy; latency needs acceptable outcomes; tokens need trustworthy usage",
      "fontSize": 16,
      "fontFamily": 2,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "3. RECORD BOTH CLOCK FAMILIES, IDENTITY, AND ADMISSION OUTCOMES\nfinal-attempt request-path clocks begin immediately before conn.request; fresh-connection setup is never subtracted\nexact caller clocks begin at the scheduled target and include queue + connect + fallback + refresh + retries\nretain response model/fingerprint + served-model-name and terminal guard events; first_content includes reasoning, visible, or refusal onset\nfailed/partial attempts remain in reliability and occupancy; latency needs acceptable outcomes; tokens need trustworthy usage",
      "lineHeight": 1.25
    },
